@model Day6_Pham_Van_Huy.Models.Genre

@{
    ViewData["Title"] = "Create Genre";
}

<h1>Create Genre</h1>

<h4>Genre (Thể loại)</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Tên thể loại</label>
                <input asp-for="Name" class="form-control" placeholder="Ví dụ: Hành động, Hoạt hình..." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

